{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "..",
    "outDir": "dist"
  },
  "include": ["../core/src/**/*.ts", "../evm/src/**/*.ts", "../sol/src/**/*.ts", "src/**/*.ts"]
}
