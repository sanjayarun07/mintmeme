# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Alchemy key: Solana mainnet reads for the /solana test UI, and the local-validator fork test (npm run verify:sol-guard)
ALCHEMY_API_KEY=

# Optional: Privy App ID (public) for "Log in with Privy" on /solana. Build the bundle once with: npm run build:privy
PRIVY_APP_ID=

# Delegated signing through Privy (planned; README "Custody plan" → setup checklist). SECRETS: fill here only, never commit or paste anywhere else.
# App settings → Basics → API keys
PRIVY_APP_SECRET=
# Wallet infrastructure → Keys and quorums → New key (the private key is shown once)
PRIVY_AUTH_KEY_ID=
PRIVY_AUTH_PRIVATE_KEY=
# Wallet infrastructure → Policies (chain type Solana; later one for Ethereum)
PRIVY_SOLANA_POLICY_ID=
PRIVY_ETHEREUM_POLICY_ID=
# Only for ERC-4337 with a separate provider instead of Privy smart wallets
AA_BUNDLER_URL=
AA_PAYMASTER_URL=

# Practice HTTP API (npm run api): "<16+ char key>:<user>[:read|trade],..."
API_KEYS=

# Execution server (npm run server); see docs/PRODUCTION_SERVER.md for every option
REDIS_URL=redis://127.0.0.1:6379
NODE_PUBLIC_URL=http://127.0.0.1:3500
API_KEYS_FILE=
# REDIS_REQUIRE_AOF=false     # only for a local Redis without appendonly
# SOLANA_SAMPLE_URL=http://127.0.0.1:3000   # serve the /solana page from the running test UI, to this machine only
