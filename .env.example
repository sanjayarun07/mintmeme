# Copy to .env and fill in. .env is never read by anything except the verify scripts, and is git-ignored.
# Alchemy key for read-only mainnet checks and fork tests
ALCHEMY_API_KEY=
# A funded TEST key for your LOCAL chain only (e.g. nitro-testnode). Never a mainnet key.
LOCAL_FUNDER_KEY=

# Optional: durable engine/order/copy state in Redis instead of JSON files (redis:// only; single writer; enable AOF: CONFIG SET appendonly yes)
REDIS_URL=redis://127.0.0.1:6379

# Telegram bot. Token from @BotFather. Leave empty to keep it off. The terminal (npm run web / web:markets) runs the bot itself and enables /link, /buy and /sell for the practice account;
# `npm run telegram` runs the community bots alone. Never run both with the same token.
TELEGRAM_BOT_TOKEN=
# Optional: an Arbitrum JSON-RPC URL for Wallet Bot balances. No default is used; without it Arbitrum balances show as unavailable.
ARBITRUM_RPC_URL=

# Optional: our own indexer (see docs/INDEXER_CONTRACT.md). Unset = third-party polling only.
INDEX_URL=
INDEX_MAX_LAG_S=60
# Optional: Solana wallet push for the Wallet Tracker (bare key or the full Helius RPC URL). Never commit this.
HELIUS_API_KEY=
# BNB Smart Chain testnet (chain 97) JSON-RPC URL for testnet checks. Never print it; never use a mainnet key.
BNB_TESTNET_RPC_URL=
# Robinhood Chain testnet JSON-RPC URL for testnet checks. Never print it; never use a mainnet key.
ROBINHOOD_TESTNET_RPC_URL=
