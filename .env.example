# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Alchemy key: Solana mainnet reads for the /solana test UI, and the local-validator fork test (npm run verify:sol-guard)
ALCHEMY_API_KEY=

# Optional: Privy App ID (public) for "Log in with Privy" on /solana. Build the bundle once with: npm run build:privy
PRIVY_APP_ID=

# Delegated signing through Privy (planned; README "Custody plan" → setup checklist). SECRETS: fill here only, never commit or paste anywhere else.
# App settings → Basics → API keys
PRIVY_APP_SECRET=
# Wallet infrastructure → Keys and quorums → New key (the private key is shown once)
PRIVY_AUTH_KEY_ID=
PRIVY_AUTH_PRIVATE_KEY=
# Wallet infrastructure → Policies (chain type Solana; and chain type Ethereum for Base, README → Base policy rules)
PRIVY_SOLANA_POLICY_ID=
PRIVY_BASE_POLICY_ID=
# Base RPC for MODE=base-mainnet (default: Alchemy with ALCHEMY_API_KEY, Base enabled on the Alchemy app)
BASE_RPC_URL=
# Relay (MODE=base-mainnet, tokens with no Uniswap V2 pool): API key for production; BASE_RELAY=off turns Relay off
RELAY_API_KEY=
BASE_RELAY=
# Base: route those tokens through KyberSwap instead of Relay (relay | kyberswap); KYBER_CLIENT_ID is sent as its x-client-id (default memedesk)
BASE_AGGREGATOR=
KYBER_CLIENT_ID=
# Several chains on one execution server, default first (replaces MODE): solana,base,bnb,robinhood
CHAINS=
# BNB Chain and Robinhood Chain (in CHAINS): each chain's Privy policy (chain type Ethereum, that chain's V2 router); RPCs default to Alchemy with ALCHEMY_API_KEY
PRIVY_BNB_POLICY_ID=
BNB_RPC_URL=
PRIVY_ROBINHOOD_POLICY_ID=
ROBINHOOD_RPC_URL=
# Only for ERC-4337 with a separate provider instead of Privy smart wallets
AA_BUNDLER_URL=
AA_PAYMASTER_URL=

# Practice HTTP API (npm run api): "<16+ char key>:<user>[:read|trade],..."
API_KEYS=

# Execution server (npm run server); see docs/PRODUCTION_SERVER.md for every option
REDIS_URL=redis://127.0.0.1:6379
NODE_PUBLIC_URL=http://127.0.0.1:3500
API_KEYS_FILE=
# REDIS_REQUIRE_AOF=false     # only for a local Redis without appendonly
# SOLANA_SAMPLE_URL=http://127.0.0.1:3000   # serve the /solana page from the running test UI, to this machine only

# Execution server with real funds (MODE=solana-mainnet): the Privy settings above plus a Solana RPC (or ALCHEMY_API_KEY)
# MODE=solana-mainnet
# SOLANA_RPC_URL=

# Execution server (MODE=solana-mainnet): 1 lets users BUY tokenized stocks (xStocks, Ondo, Backpack). Off by default; no issuer offers them to US persons.
STOCKS_ENABLED=

# Jupiter API key (Solana: route building, quotes, prices, JupiterZ, the RFQ Desk). Optional; keyless is about one request every 2 seconds
JUPITER_API_KEY=
# Robinhood Chain: KyberSwap for tokens with no usable V2 pool (kyberswap, the default, or off)
ROBINHOOD_AGGREGATOR=
