{
  "name": "memedesk",
  "private": true,
  "type": "module",
  "description": "Trading SDK (engine, Solana and EVM adapters, HTTP API), a horizontally scalable execution server, and a Solana test UI",
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test \"packages/core/test/*.test.ts\" \"packages/evm/test/*.test.ts\" \"packages/sol/test/*.test.ts\" \"packages/sdk/test/*.test.ts\" \"apps/web/test/*.test.ts\" \"apps/server/*.test.ts\"",
    "bench": "node --experimental-transform-types --no-warnings bench/bench.ts",
    "build:sdk": "cd packages/sdk && node scripts/build.mjs",
    "pack:sdk": "npm run build:sdk && cd packages/sdk && npm pack",
    "api": "node --env-file-if-exists=.env --experimental-transform-types --no-warnings apps/api/start.ts",
    "server": "node --env-file-if-exists=.env --experimental-transform-types --no-warnings apps/server/main.ts",
    "server:key": "node --experimental-transform-types --no-warnings apps/server/keys.ts",
    "web": "node --env-file-if-exists=.env --experimental-transform-types --no-warnings apps/web/server.ts",
    "build:privy": "cd apps/privy && npm install && npm run build",
    "verify:sol-guard": "node --env-file-if-exists=.env --experimental-transform-types --no-warnings packages/live/src/solguardfork.ts",
    "server:loadtest": "node --experimental-transform-types --no-warnings apps/server/loadtest.ts",
    "verify:evm": "node --env-file-if-exists=.env --experimental-transform-types --no-warnings packages/live/src/traderfork.ts"
  },
  "engines": {
    "node": ">=22.18"
  }
}
